# scripts/export-survey-data.js output — contains real study-participant
# answers (NASA-TLX/SUS/UEQ scores, lrs_status, slt_role, age_group,
# first_language); never belongs in version control, see
# supabase/00_survey_schema.sql's RLS comment for why it only lives in
# Supabase behind the service_role key.
